    "rich_text_XpTrJj": {
      "type": "rich-text",
      "blocks": {
        "title_YkWtnH": {
          "type": "title",
          "settings": {
            "title": "ИНОВАТИВНА ГРИЖА ЗА КОЖАТА, ЗАХРАНВАНА ОТ ПРИРОДАТА",
            "title_size": "heading-size--small",
            "seo_h_tag": "h2"
          }
        },
        "text_UYkfNd": {
          "type": "text",
          "settings": {
            "text": "<p>Pamaura е въплъщение на изисканата грижа за кожата, безпроблемно съчетаваща силите на природата и научните иновации. В основата му е звездната съставка, пшеничният зародиш, щателно включен във всеки продукт заради неговата подхранваща антиоксидантна сила. Марката е доказателство за непоколебима отдаденост, предлагайки качество без компромис, гарантирайки, че всяка формула постига доказани резултати. Същността на Pamaura се крие в съчетаването на достъпност с ефикасност, което прави сияйна и уверена грижа за кожата достъпна за всички. С искрена отдаденост на отговорните и устойчиви практики, Pamaura ви кани на пътешествие, където силата на природата и прецизността на науката се сливат, създавайки изживяване в грижата за кожата, което е едновременно луксозно и основано на реални, измерими резултати. Добре дошли в Pamaura, където автентичността среща съвършенството.<\/p>",
            "text_size": "regular"
          }
        }
      },
