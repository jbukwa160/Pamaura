      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "stars_font_size_mobile",
      "label": "Stars Font Size Mobile",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "label_font_size_desktop",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Label Font Size Desktop",
      "default": 16
