      "info": "This will separate text from button and the button"
    },
    {
      "type": "checkbox",
      "id": "separate_text_btn_mobile",
      "label": "Separate Text from Button Mobile",
      "default": false,
      "info": "This will separate text from button and the button"
    },
    {
      "type": "select",
      "id": "button_position_desktop",
      "label": "Button Position Desktop",
      "options": [
        {
          "value": "top-left",
          "label": "Top Left"
        },
        {
          "value": "top-right",
          "label": "Top Right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom Left"
        },
        {
          "value": "bottom-right",
          "label": "Bottom Right"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "bottom-right"
    },
    {
      "type": "select",
      "id": "button_position_mobile",
      "label": "Button Position Mobile",
      "options": [
        {
          "value": "top-left",
          "label": "Top Left"
        },
        {
          "value": "top-right",
