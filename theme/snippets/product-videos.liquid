<script src="{{ 'component-product-video.js' | asset_url }}" defer></script>

<div class="product-videos">
  <div class="product-videos__heading">
    <h2>{{ block.settings.heading }}</h2>
    <p>{{ block.settings.description }}</p>
  </div>
  <div
    class="product-videos__videos swiper"
    id="product-videos-{{ section.id }}"
    data-slides-per-view="{{ block.settings.slides_per_view }}"
  >
    <div class="swiper-wrapper">
      {% for i in (1..5) %}
        {% assign video_key = 'video_' | append: i %}
        {% if block.settings[video_key] != blank %}
          <div
            class="product-videos__video swiper-slide"
            style="--video-border-radius: {{ block.settings.videos_border_radius }}px;"
          >
            <product-video data-video-id="video-id-{{ i }}">
              {{
                block.settings[video_key]
                | video_tag: controls: false, autoplay: false, muted: false, class: 'custom-video-player'
              }}
              <button class="custom-play-button">▶</button>
            </product-video>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="swiper-navigation">
      <button class="swiper-button-prev">
        <svg xmlns="http://www.w3.org/2000/svg" width="8" height="13" viewBox="0 0 8 13" fill="none">
