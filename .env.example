# Copy to .env.local and fill in. Everything is optional except SITE_URL in production.
# Never commit .env.local.

# ---- Site
# The public address (used in e-mails, canonical links, sitemaps, secure cookies).
SITE_URL=https://pamaura.com
# Where the database, uploaded pictures, fonts and e-mail outbox live (default: ../pamaura-data).
DATA_DIR=
# Reverse proxy in front of Node: empty = 1 proxy when SITE_URL is https, 0 = none,
# 1..5 = number of proxies, x-real-ip = use that header.
TRUST_PROXY=
# First order number (default 1001).
ORDER_NUMBER_START=

# ---- E-mail (order confirmations, shipping notices, password resets)
# Without SMTP_HOST e-mails are written to DATA_DIR/outbox instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PAMAURA <hello@pamaura.com>
# Where "new order" notices go.
SHOP_NOTIFY_EMAIL=hello@pamaura.com

# ---- Couriers (details: src/lib/shipping/couriers/ENV.md)
# Econt and BOX NOW office / locker lists work without logins; Speedy needs its login for everything.
SENDER_NAME=
SENDER_CONTACT=
SENDER_PHONE=
SENDER_EMAIL=
SENDER_CITY=
SENDER_POSTCODE=
SENDER_ADDRESS=

ECONT_USERNAME=
ECONT_PASSWORD=
ECONT_ENV=
ECONT_SENDER_PAYMENT=
ECONT_DROPOFF_OFFICE_CODE=

SPEEDY_USERNAME=
SPEEDY_PASSWORD=
SPEEDY_SERVICE_ID=
SPEEDY_PAYER=
SPEEDY_DROPOFF_OFFICE_ID=

BOXNOW_API_URL=
BOXNOW_CLIENT_ID=
BOXNOW_CLIENT_SECRET=
BOXNOW_WAREHOUSE_ID=
BOXNOW_COMPARTMENT_SIZE=

# ---- Rarely needed
# Instagram feed script of the Instafeed account (default: the one the live store uses).
INSTAFEED_SCRIPT=
# Theme folder (default ./theme) and template cache ("0" = re-read the theme on every request, for theme work).
THEME_DIR=
THEME_CACHE=

# ---- Import scripts only (npm run import:all)
# Shopify store to copy from (default https://pamaura.com).
SHOP_URL=
# Products CSV exported from Shopify, for stock quantities and barcodes.
STOCK_CSV=
# Judge.me shop domain for the reviews import.
JUDGEME_SHOP_DOMAIN=
# Pause between requests to the live store (ms).
IMPORT_DELAY_MS=
